# ==========================================
# StrangerChat Production Environment Config
# ==========================================

# Server Port (Defaults to 3000 for Cloud Run / container ingress)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# CORS / Origin Security
# Comma-separated list of allowed frontend origins (e.g. https://strangerchat.example.com)
# Leave empty in local development to allow same-origin/localhost
ALLOWED_ORIGINS=

# Frontend WebSocket Server URL
# If left empty, the frontend auto-detects ws:// or wss:// based on window.location
VITE_WS_URL=

# WebRTC STUN Server Configuration (Comma-separated list)
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# WebRTC TURN Server Configuration Placeholders (For NAT/Symmetric Firewall Traversal)
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Backend TURN/STUN Placeholders
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Admin Control Panel Credentials (Server-Side Only - Never commit actual secrets)
ADMIN_USERNAME=
ADMIN_PASSWORD=

